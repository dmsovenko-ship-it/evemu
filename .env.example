# EVEmu Production Environment Variables
# Copy to .env and adjust for your VDS

# Market seeding (TRUE = seed on first start, FALSE = skip)
SEED_MARKET=TRUE

# Market saturation percentage (default: 75)
SEED_SATURATION=75

# Regions to seed (comma-separated)
SEED_REGIONS=The Forge,The Citadel,Lonetrek,Black Rise,Domain,Devoid,The Bleak Lands,Aridia,Genesis,Kador,Khanid,Kor-Azor,Tash-Murkon,Derelik,Essence,Everyshore,Placid,Verge Vendor,Sinq Laison,Solitude,Heimatar,Metropolis,Molden Heath,Curse,Stain,Venal,Great Wildlands,Syndicate,Outer Ring

# Run with GDB (TRUE/FALSE — FALSE for production)
RUN_GDB=FALSE

# MariaDB credentials (change for production!)
MARIADB_USER=evemu
MARIADB_PASSWORD=evemu
MARIADB_DATABASE=evemu

# Image server public IP/hostname (must be reachable by clients)
IMAGE_SERVER_HOST=127.0.0.1
